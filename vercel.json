{
  "functions": {
    "api/*.js": {
      "maxDuration": 60,
      "includeFiles": "{config.json,flight_history.json,latest_snapshot.json}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/public/:path*"
    }
  ]
}
